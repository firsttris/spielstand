// Renovate (GitHub App, https://github.com/apps/renovate): a pull request for each new release of
// what Spielstand builds on, plus the "Dependency Dashboard" issue listing what is open. Their own
// pull requests: Ludusavi (scanner, manifest and backup layout, pinned exactly in both crates that
// use it), Bun (image and web/package.json) and MkDocs Material of the docs workflow. Rust floats
// (rust-toolchain.toml "stable", rust:1-bookworm), and the image stays on Debian bookworm on
// purpose: the agent is linked against its glibc 2.36.
// Everything else (the other packages, the actions, the images) comes with the shared settings of
// firsttris/workflows (renovate/default.json5): minor and patch updates once a month in one pull
// request that merges itself when CI is green, majors on request in the dashboard.
// Check with `bunx --package renovate renovate-config-validator .github/renovate.json5`.
{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["github>firsttris/workflows//renovate/default.json5"],
  customManagers: [
    {
      // The Ludusavi version CLAUDE.md and docs/development.md name (the reference clone and the
      // pin), so they move with the two Cargo.toml
      customType: "regex",
      managerFilePatterns: ["/^CLAUDE\\.md$/", "/^docs/development\\.md$/"],
      matchStrings: [
        "`=(?<currentValue>\\d+\\.\\d+\\.\\d+)`",
        "--branch v(?<currentValue>\\d+\\.\\d+\\.\\d+)",
        'ludusavi = "=(?<currentValue>\\d+\\.\\d+\\.\\d+)"',
      ],
      depNameTemplate: "ludusavi",
      datasourceTemplate: "crate",
    },
    {
      customType: "regex",
      managerFilePatterns: ["/^\\.github/workflows/docs\\.yml$/"],
      matchStrings: ["pip install mkdocs-material==(?<currentValue>[^\\s]+)"],
      depNameTemplate: "mkdocs-material",
      datasourceTemplate: "pypi",
    },
  ],
  packageRules: [
    {
      // Rust floats; bookworm stays for the agent's glibc (docker/Dockerfile). Spielstand's own
      // image moves with its releases.
      matchPackageNames: ["rust", "debian", "docker.io/tristanteu/**", "tristanteu/**"],
      enabled: false,
    },
    {
      // Pinned exactly (=x.y.z) in crates/agent and crates/server
      matchPackageNames: ["ludusavi"],
      enabled: true,
      groupName: "Ludusavi",
      sourceUrl: "https://github.com/mtkennerly/ludusavi",
      commitMessageTopic: "Ludusavi",
      prBodyNotes: [
        "Ludusavi is used only through `crates/agent/src/engine.rs` (the `Scanner` trait: scan, manifest, `add_custom_game`) and `crates/server/src/importer.rs` (its backup layout for `import-ludusavi`); a bump starts there and in their tests. Before merging: read the CHANGELOG and compare `src/scan.rs`, `src/scan/layout.rs`, `src/resource/manifest.rs` and `src/prelude.rs` between the two tags (CLAUDE.md, Reference implementations); the path placeholders in `crates/core/src/custom.rs` follow `manifest.rs`. `cargo test --workspace` must be green, then run **Actions → Long simulation → Run workflow** on this branch, and `bun run e2e:stack` (real server and agents).",
      ],
      schedule: ["at any time"],
      automerge: false,
      dependencyDashboardApproval: false,
    },
    {
      // Bun of the image's web stage (oven/bun, dockerfile manager) and of web/package.json, in
      // one PR, majors too. Renovate's bun manager reads "packageManager": "bun@x.y.z" itself, as
      // the npm package `bun`; a regex manager for it would edit the line a second time.
      matchPackageNames: ["docker.io/oven/bun", "oven/bun", "bun"],
      enabled: true,
      groupName: "Bun",
      sourceUrl: "https://github.com/oven-sh/bun",
      prBodyNotes: [
        "The image's `web` stage (`oven/bun:<version>-slim`) and `packageManager` in `web/package.json` (CI takes its version from there: setup-bun, and npm in the Playwright image) move together. Bun installs the packages and runs the scripts and the Playwright runner (`bun --bun playwright test`). Run `bun install` in case `web/bun.lock` changes. CI's docker job builds and starts the image.",
      ],
      schedule: ["at any time"],
      automerge: false,
      dependencyDashboardApproval: false,
    },
    {
      matchPackageNames: ["mkdocs-material"],
      sourceUrl: "https://github.com/squidfunk/mkdocs-material",
      prBodyNotes: ["The docs job of this PR runs `mkdocs build --strict` with it."],
      groupName: "mkdocs-material",
      schedule: ["at any time"],
      automerge: false,
      dependencyDashboardApproval: false,
    },
  ],
}
