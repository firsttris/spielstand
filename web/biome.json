{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "includes": [
      "**",
      "!src/paraglide",
      "!src/routeTree.gen.ts",
      "!src/bindings",
      "!dist",
      "!test-results",
      "!playwright-report",
      "!project.inlang/cache",
      "!project.inlang/.meta.json",
      "!project.inlang/.lix"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "lineWidth": 110
  },
  "linter": {
    "rules": {
      "preset": "recommended"
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  }
}
